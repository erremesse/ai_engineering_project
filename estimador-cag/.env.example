# LLM Provider configuration
LLM_PROVIDER=<ollama|anthropic|openai>

ANTHROPIC_API_KEY=<your_anthropic_api_key>
ANTHROPIC_MODEL=claude-haiku-4-5

OPENAI_API_KEY=<your_openai_api_key>
OPENAI_MODEL=gpt-4o-mini

# Ollama — optional remote server (leave blank to disable)
OLLAMA_API_BASE=<>
OLLAMA_MODELS=<Ex: llama3.3:70b,deepseek-r1:70b>

# Embeddings (embedding_pipeline)
EMBEDDING_PROVIDER=<openai|ollama>
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Dimension of the configured embedding model — must be kept in sync manually:
# text-embedding-3-small (openai) -> 1536, nomic-embed-text (ollama) -> 768
EMBEDDING_DIMENSION=1536

# Database (pgvector persistence)
DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator

# CAG / cache
NUM_CAG_EXAMPLES=5
CACHE_TTL=86400

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Streamlit — base URL of the FastAPI server (no trailing slash)
ESTIMADOR_API_BASE=http://localhost:8000

# RAG (retrieval + generation, Sesion 09)
# Leave blank in local dev to disable auth on /v1/retrieval and /v1/estimate.
RETRIEVAL_API_KEY=<>
ESTIMATE_API_KEY=<>
RAG_TOP_K=10
RAG_DISTANCE_THRESHOLD=0.6
RAG_MAX_CONTEXT_TOKENS=4000
