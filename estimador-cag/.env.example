# LLM Provider configuration
LLM_PROVIDER=<ollama|anthropic|openai>

ANTHROPIC_API_KEY=<your_anthropic_api_key>
ANTHROPIC_MODEL=claude-haiku-4-5

OPENAI_API_KEY=<your_openai_api_key>
OPENAI_MODEL=gpt-4o-mini

# Ollama — optional remote server (leave blank to disable)
OLLAMA_API_BASE=<>
OLLAMA_MODELS=<Ex: llama3.3:70b,deepseek-r1:70b>

# Embeddings (embedding_pipeline)
EMBEDDING_PROVIDER=<openai|ollama>
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# CAG / cache
NUM_CAG_EXAMPLES=5
CACHE_TTL=86400

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Streamlit — base URL of the FastAPI server (no trailing slash)
ESTIMADOR_API_BASE=http://localhost:8000
