# Copy to .env and fill in real values locally: cp .env.example .env
# .env is git-ignored — never commit real keys.

# --- LLM provider (servicio IA) ---
LLM_PROVIDER=<ollama|anthropic|openai>

ANTHROPIC_API_KEY=
# claude-sonnet-5 is what the Session 15 end-to-end check runs with (see
# docs/deployment-local.md). claude-haiku-4-5 is cheaper for CAG-only use.
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama — optional remote server (leave blank to disable). From a container,
# an Ollama running on your own machine is http://host.docker.internal:11434
OLLAMA_API_BASE=
OLLAMA_MODELS=<Ex: llama3.3:70b,deepseek-r1:70b>

# --- Embeddings (embedding_pipeline) ---
EMBEDDING_PROVIDER=<openai|ollama>
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Dimension of the configured embedding model — must be kept in sync manually:
# text-embedding-3-small (openai) -> 1536, nomic-embed-text (ollama) -> 768
EMBEDDING_DIMENSION=1536

# --- Internal service-to-service auth (business-backend -> servicio IA) ---
# Mandatory for docker compose. Generate one: openssl rand -hex 32
AI_SERVICE_TOKEN=change-me

# How the business-backend reaches the AI service (compose DNS name, not localhost)
AI_SERVICE_URL=http://ai-service:8000

# --- Relational DB (business-backend: estimation history) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=estimation

# --- Vector DB (servicio IA: pgvector) ---
VECTOR_DB_USER=estimator
VECTOR_DB_PASSWORD=estimator
VECTOR_DB_NAME=estimator

# Only for running the AI service outside Docker (compose overrides it):
DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator

# --- CAG / cache ---
NUM_CAG_EXAMPLES=5
CACHE_TTL=86400

# --- Application ---
APP_ENV=development
LOG_LEVEL=DEBUG

# --- RAG (retrieval + generation, Sesion 09) ---
# Second auth layer (X-API-Key) on /v1/retrieval and /v1/estimate.
# Leave blank to disable it; the X-Service-Token layer still applies.
RETRIEVAL_API_KEY=
ESTIMATE_API_KEY=
RAG_TOP_K=10
RAG_DISTANCE_THRESHOLD=0.6
RAG_MAX_CONTEXT_TOKENS=4000

# --- Hybrid search + reranking (Sesion 10) ---
RAG_SEARCH_MODE=<vector|hybrid>
RAG_RERANK_ENABLED=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RECALL_POOL_SIZE=50
RAG_RRF_K=60

# --- Production metrics (Sesion 16, docs/evaluation.md) ---
# Compose already sets METRICS_LOG_PATH=/app/metrics/estimate_requests.jsonl.
# USD per million tokens of the ACTIVE model, used to derive cost per request.
# claude-sonnet-5: 2 / 10 · claude-haiku-4-5: 1 / 5 · ollama (self-hosted): 0 / 0
LLM_PRICE_INPUT_PER_MTOK_USD=2.0
LLM_PRICE_OUTPUT_PER_MTOK_USD=10.0
